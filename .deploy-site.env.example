# Copy to .deploy-site.env (not committed). One NAME=value per line, no spaces around =, no quotes needed.
VITE_SENTRY_DSN=https://<key>@o<number>.ingest.de.sentry.io/<number>
VITE_SUPPORT_EMAIL=you@example.com
# Only for readable crash reports (source maps); leave these out to skip it:
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=vayu-web
SENTRY_URL=https://de.sentry.io
