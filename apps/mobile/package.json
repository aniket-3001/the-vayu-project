{
  "name": "@vayu/mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync",
    "typecheck": "tsc -p .",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --android --ios --assetPath assets --iconBackgroundColor #F4F6F8 --iconBackgroundColorDark #101820 --splashBackgroundColor #F4F6F8 --splashBackgroundColorDark #101820 && node scripts/shrink-art.mjs",
    "shrink-art": "node scripts/shrink-art.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2"
  }
}
